<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      深色科技感主题。
      父主题必须是 MaterialComponents 系（MaterialButton / MaterialCardView /
      LinearProgressIndicator 会在 inflate 时校验，非 Material 主题会直接抛异常），
      DayNight 只是父系，下面把所有关键属性显式写成固定深色值，
      这样即使系统处于浅色模式，界面依然是深色，不会出现「黑底黑字」。
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- 品牌 -->
        <item name="colorPrimary">@color/brandPrimary</item>
        <item name="colorPrimaryDark">@color/bgDark</item>
        <item name="colorSecondary">@color/brandSecondary</item>
        <item name="colorAccent">@color/brandPrimary</item>
        <item name="colorOnPrimary">@color/textOnBrand</item>
        <item name="colorOnSecondary">@color/textOnBrand</item>

        <!-- 表面 / 背景 -->
        <item name="colorSurface">@color/bgCard</item>
        <item name="colorOnSurface">@color/textTitle</item>
        <item name="android:colorBackground">@color/bgScreen</item>
        <item name="android:windowBackground">@color/bgScreen</item>
        <item name="android:statusBarColor">@color/bgDark</item>
        <item name="android:navigationBarColor">@color/bgDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- 文字 -->
        <item name="android:textColorPrimary">@color/textTitle</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorTertiary">@color/textDim</item>
        <item name="android:textColorHint">@color/textDim</item>
        <item name="android:textColor">@color/textBody</item>
        <item name="android:colorForeground">@color/textBody</item>

        <!-- 控件着色 -->
        <item name="colorControlNormal">@color/textSecondary</item>
        <item name="colorControlActivated">@color/brandPrimary</item>
        <item name="colorControlHighlight">@color/rippleNormal</item>
        <item name="android:colorControlHighlight">@color/rippleNormal</item>

        <!-- 普通 Button（应用内若还有原生 Button，给个统一外观；三个弹窗的按钮也走它） -->
        <item name="buttonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- 普通按钮：深底 + 细描边 + 圆角 -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sel_btn_normal_text</item>
        <item name="backgroundTint">@color/sel_btn_normal_tint</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/borderStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/rippleNormal</item>
    </style>

    <!-- 主按钮：渐变 + 大高度 -->
    <style name="Widget.App.Button.Primary" parent="Widget.App.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sel_btn_primary_text</item>
        <item name="android:background">@drawable/sel_btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 快捷入口：浅青描边，表达「打开网页」而不是「执行命令」 -->
    <style name="Widget.App.Button.Link" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sel_btn_link_text</item>
        <item name="backgroundTint">@color/sel_btn_link_tint</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/linkStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/linkFillPressed</item>
    </style>

    <!-- 分组小标题 -->
    <style name="Widget.App.GroupTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 状态卡行标签 / 行值 -->
    <style name="Widget.App.StatusLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/textBody</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.App.StatusValue" parent="android:Widget.TextView">
        <item name="android:textColor">@color/textDim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">end</item>
    </style>

</resources>
