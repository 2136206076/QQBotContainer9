# ============================================================
# Termux + proot-distro(Ubuntu) 部署参数
# 被 scripts/ 下所有脚本 source，改这里就够了
# ============================================================

# ---- 目录（全部放在 proot rootfs 内部，不要放 /sdcard）----
QQ_DIR=${QQ_DIR:-/opt/QQ}                 # Linux 版 QQ
SNOWLUMA_DIR=${SNOWLUMA_DIR:-/opt/snowluma}   # 协议端
AGENT_DIR=${AGENT_DIR:-/opt/qqagent}      # QQ Agent（大脑 + 控制台）
STACK_DIR=${STACK_DIR:-/opt/qqstack}      # hook 载入器 / 载荷 / 脚本 / VNC 密码

# ---- 身份 ----
QQ_UID=${QQ_UID:-0}                       # proot-distro 默认 root，就是 0
QQ_HOME=${QQ_HOME:-/root}

# ---- 桌面 / 端口 ----
DISPLAY=${DISPLAY:-:1}
VNC_PORT=${VNC_PORT:-5900}
NOVNC_PORT=${NOVNC_PORT:-6081}
SLWEBUI_PORT=${SLWEBUI_PORT:-5099}
BOT_HTTP=${BOT_HTTP:-3000}
BOT_WS=${BOT_WS:-3001}
AGENT_PORT=${AGENT_PORT:-3210}

# ---- hook ----
HOOK_SO=${HOOK_SO:-$SNOWLUMA_DIR/native/snowluma-linux-arm64.so}
RESIDENT_SO=${RESIDENT_SO:-$STACK_DIR/libsnowluma_linux_resident_dispatch.so}
LOADER_SO=${LOADER_SO:-$STACK_DIR/libslhook.so}
RUNTIME_DIR=${RUNTIME_DIR:-/tmp/snowluma-${QQ_UID}}
# 等 wrapper.node 出现再装 hook（默认开）。设 0 会在进程一启动就装，可能撞 Chromium 崩溃
SLHOOK_WAIT_WRAPPER=${SLHOOK_WAIT_WRAPPER:-1}
SLHOOK_DELAY_MS=${SLHOOK_DELAY_MS:-5000}
# SLHOOK_VERBOSE=1 打开 dlopen 逐行日志（排障用）

# ---- QQ 启动参数（崩了往这里加 --no-zygote 之类）----
QQ_EXTRA_ARGS=${QQ_EXTRA_ARGS:-}

# ---- 宿主真实路径（/proc/<pid>/maps 里看到的那个前缀，用于建路径别名）----
# Termux + proot-distro 的默认值；留空则脚本自动探测
HOST_ROOT=${HOST_ROOT:-/data/data/com.yuanbao.qqbot/files/rootfs}

# ---- 其它 ----
BOOT_WAIT=${BOOT_WAIT:-120}               # 拉起后最多等多少秒看 OneBot 是否就绪
